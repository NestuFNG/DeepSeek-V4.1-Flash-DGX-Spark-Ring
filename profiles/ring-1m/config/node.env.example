# Copy to node.env outside Git and edit per host. Addresses below are documentation examples.
STATE_DIR=/srv/dsv41-state
MODEL_DIR=/srv/models/DeepSeek-V4.1-Flash
NCCL_DIR=/srv/nccl-patched
RANK=0
HOST_IP=192.0.2.10
MASTER_ADDR=192.0.2.10
MGMT_IFNAME=YOUR_MANAGEMENT_INTERFACE
RDMA_HCAS=YOUR_COMMA_SEPARATED_RDMA_DEVICES
IMAGE=local/dsv41-ring-ssd:fi07-20260911
CONTAINER_NAME=dsv41-ring-1m
# Rank order follows the cable cycle A -> B -> C -> D -> A.
